# ==============================================================================
# DVWA DevSecOps - Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env before running docker-compose:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit the actual .env file to Git!
# - Ensure passwords are strong in production-like deployments.
# ==============================================================================

# Application Port (Mapped to localhost only: 127.0.0.1)
APP_PORT=4280

# Database Connection Settings
DB_SERVER=db
DB_PORT=3306
DB_DATABASE=dvwa
DB_USER=dvwa
DB_PASSWORD=dvwa_user_secure_pass_change_me
MYSQL_ROOT_PASSWORD=dvwa_root_secure_pass_change_me

# DVWA Runtime Security and Localization
# Options for DEFAULT_SECURITY_LEVEL: low, medium, high, impossible
DEFAULT_SECURITY_LEVEL=low
DEFAULT_LOCALE=en

# ReCAPTCHA Configuration (Optional - leave blank if not using Insecure CAPTCHA)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
